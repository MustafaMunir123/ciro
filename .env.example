# Core AI + map keys
# Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Google Maps key (enable Maps JavaScript + Places APIs): https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# External intel ingestion APIs (new layer)
# SerpAPI key (Google News Light engine): https://serpapi.com/manage-api-key
NEWS_API_KEY=your_news_api_key_here
# Your own social provider endpoint + key (internal/custom service)
SOCIAL_API_URL=https://your-social-api/search
SOCIAL_API_KEY=your_social_api_key_here
# Third-party Social Media Resource API (PR #1 contract)
# Base example: https://your-social-api-host
SOCIAL_MEDIA_RESOURCE_API_BASE=https://your-social-api-host
SOCIAL_MEDIA_RESOURCE_API_KEY=your_social_media_resource_api_key
# Third-party Social Media Resource API (PR #1 contract)
# Base example: https://your-social-api-host
SOCIAL_MEDIA_RESOURCE_API_BASE=https://your-social-api-host
SOCIAL_MEDIA_RESOURCE_API_KEY=your_social_media_resource_api_key

# WeatherAPI.com
# WeatherAPI key: https://www.weatherapi.com/my/
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_API_TLS_INSECURE_FALLBACK=true
MAPS_API_TLS_INSECURE_FALLBACK=true
THUMBNAIL_TLS_INSECURE_FALLBACK=true
GCP_SERVICE_KEY_JSON=

# Client-side rate-limit controls (milliseconds)
NEXT_PUBLIC_INTEL_API_DELAY_MS=1200
NEXT_PUBLIC_WEATHER_API_DELAY_MS=1200
NEXT_PUBLIC_GEMINI_API_DELAY_MS=2500
NEXT_PUBLIC_GEMINI_MAX_RPM=4
NEXT_PUBLIC_GEMINI_WARMUP_ENABLED=false

# Supabase (event persistence + external API consumption)
# Supabase project URL + publishable key: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Backward-compatible alias (optional)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase secret/service key: Supabase Dashboard -> Project Settings -> API -> service_role/secret key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Backward-compatible alias (optional)
SUPABASE_SECRET_KEY=your_supabase_service_role_key
# Keep true only if your environment has TLS/certificate chain issues
SUPABASE_TLS_INSECURE_FALLBACK=true
